# ============ Existing ============
APP_PORT=8686
APP_ENV=development
FRONTEND_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=YourStrongPassword123!
DB_NAME=pasti_v3_db

JWT_SECRET=ganti-dengan-secret-key-yang-sangat-panjang-dan-random
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

PASSWORD_PEPPER=ganti-dengan-pepper-secret-yang-berbeda-dari-jwt-secret

# ============ SSO Kemenkeu (OIDC) ============
# SSO_ENV: development | production
SSO_ENV=development
SSO_CLIENT_ID=pasti
SSO_CLIENT_SECRET=85945489a13e47c8baa274d460e15337
SSO_SCOPE=openid profile
SSO_REDIRECT_URI=http://localhost:8686/sso/callback/login

# ============ Superadmin Permanen (tidak bisa dihapus/diubah) ============
# Satu-satunya cara menjadi superadmin: identitas SSO Kemenkeu yang emailnya (SUPERADMIN_PROTECTED_EMAIL) atau NIP-nya (SUPERADMIN_PROTECTED_NIP) tercantum di sini.
# Boleh beberapa entri dipisah koma. Hanya superadmin yang mengakses seluruh fitur; setiap kali server dimulai, akun yang bukan superadmin menurut daftar ini
# diturunkan, dan yang cocok dinaikkan. Jangan dikosongkan di produksi.
SUPERADMIN_PROTECTED_EMAIL=auliyaputraazhari@kemenkeu.go.id
SUPERADMIN_PROTECTED_NIP=199609102018011005

# ============ Sinkronisasi otomatis Digitalisasi Aset (opsional; bawaan: aktif, tiap 7 hari, mulai 01.00-05.00 WIB) ============
# Hanya berjalan bila SLDK_DB_* terisi. Lihat docs/digitalisasi-aset.md.
# DIGITALISASI_AUTO_SYNC=true
# DIGITALISASI_AUTO_INTERVAL_HARI=7
# DIGITALISASI_AUTO_JAM_MULAI=1
# DIGITALISASI_AUTO_JAM_AKHIR=5

# ============ Penarikan data Pengadaan/Tender/E-Katalog otomatis (opsional; bawaan: aktif, tiap 2 hari, mulai 01.00-05.00 WIB) ============
# Hanya berjalan bila INAPROC_TOKEN terisi. Nilai ini hanya bawaan: pengaturan yang disimpan dari halaman Penarikan Data menggantikannya.
# INAPROC_AUTO_SYNC=true
# INAPROC_AUTO_INTERVAL_HARI=2
# INAPROC_AUTO_JAM_MULAI=1
# INAPROC_AUTO_JAM_AKHIR=5
# INAPROC_AUTO_JUMLAH_TAHUN=2

# ============ Batas permintaan ke Inaproc dan kebijakan gagal tarik (opsional) ============
# Inaproc membatasi 1.000 permintaan per 60 detik dan kuota 5.000 permintaan per jam (direset tiap 1 jam). Bawaan di bawah sengaja sedikit
# di bawah batas itu. Gagal tarik: maksimal 3 percobaan dalam satu siklus, lalu istirahat 8 jam sebelum ditarik ulang otomatis.
# INAPROC_BATAS_PER_MENIT=800
# INAPROC_BATAS_PER_JAM=4500
# INAPROC_MAKS_PERCOBAAN=3
# INAPROC_ISTIRAHAT_JAM=8